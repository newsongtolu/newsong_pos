<div style="font-family: Arial, sans-serif; background-color: #090e1a; color: #f8fafc; padding: 24px;">
  <div style="max-width: 600px; margin: 0 auto; background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 24px;">
    <h2 style="color: #fbbf24; margin-top: 0;">Official Updated E-Receipt</h2>
    <p style="color: #94a3b8; font-size: 14px;">Your order has been adjusted and updated by the cashier terminal.</p>
    
    <hr style="border: 0; border-top: 1px solid #334155; margin: 16px 0;">
    
    <p><strong>Order ID:</strong> #<%= @order.id %></p>
    <p><strong>Customer Name:</strong> <%= @order.customer_name %></p>
    <p><strong>Service Mode:</strong> <%= @order.service_mode %> &bull; <%= @order.fulfillment_type %></p>
    <p><strong>Payment Method:</strong> <%= @order.payment_method %></p>
    
    <hr style="border: 0; border-top: 1px solid #334155; margin: 16px 0;">
    
    <h3 style="font-size: 14px; text-transform: uppercase; color: #94a3b8;">Updated Item Breakdown:</h3>
    <% if @order.order_items.any? %>
      <% @order.order_items.each do |item| %>
        <div style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 8px;">
          <span><%= item.quantity %>x <%= item.name %></span>
          <span style="color: #34d399; font-family: monospace;">₦<%= number_with_precision(item.price.to_f * item.quantity.to_f, precision: 2) %></span>
        </div>
      <% end %>
    <% else %>
      <p style="font-style: italic; color: #94a3b8;">No item rows attached.</p>
    <% end %>
    
    <hr style="border: 0; border-top: 1px solid #334155; margin: 16px 0;">
    
    <div style="text-align: right;">
      <span style="font-size: 12px; color: #94a3b8; text-transform: uppercase; display: block;">Adjusted Grand Total</span>
      <span style="font-size: 18px; font-weight: bold; color: #34d399;">₦<%= number_with_precision(@order.grand_total.to_f, precision: 2) %></span>
    </div>
  </div>
</div>
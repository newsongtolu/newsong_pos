<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Staff - Admin Panel</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --bg-main: #0b0f19; --bg-card: #151c2c; --border-color: #26334d;
      --text-main: #f1f5f9; --text-muted: #94a3b8; --accent: #10b981;
    }
    body { background-color: var(--bg-main); color: var(--text-main); font-family: system-ui, sans-serif; margin: 0; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
    .card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; }
    .btn { background: var(--accent); color: white; border: none; padding: 10px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; text-decoration: none; display: inline-block; font-size: 0.9rem; width: 100%; text-align: center; }
    input, select { background: #0b0f19; border: 1px solid var(--border-color); color: white; padding: 10px; border-radius: 6px; width: 100%; box-sizing: border-box; margin-top: 6px; margin-bottom: 15px; }
    label { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; }
  </style>
</head>
<body>
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <h1 style="margin: 0; font-size: 1.4rem; color: #facc15;">➕ Create New Staff Account</h1>
      <%= link_to "← Back", admin_users_path, class: "btn", style: "background: #374151; width: auto; padding: 8px 14px;" %>
    </div>

    <div class="card">
      <%= form_with model: [:admin, @user], local: true do |f| %>
        <div>
          <label>Full Name</label>
          <%= f.text_field :name, placeholder: "e.g. John Doe", required: true %>
        </div>
        <div>
          <label>Email Address</label>
          <%= f.email_field :email, placeholder: "staff@newsong.com", required: true %>
        </div>
        <div>
          <label>Assigned Role</label>
          <%= f.select :role, options_for_select([['Cashier', 'cashier'], ['Kitchen Staff', 'kitchen'], ['Floor / Waiter', 'floor'], ['Dispatcher', 'dispatch'], ['Super Admin', 'super_admin']]), {}, required: true %>
        </div>
        <div>
          <label>Password</label>
          <%= f.password_field :password, placeholder: "••••••••", required: true %>
        </div>
        <div>
          <label>Confirm Password</label>
          <%= f.password_field :password_confirmation, placeholder: "••••••••", required: true %>
        </div>
        <div>
          <%= f.submit "Create Staff Account", class: "btn", style: "background: #10b981; margin-top: 10px;" %>
        </div>
      <% end %>
    </div>
  </div>
</body>
</html>
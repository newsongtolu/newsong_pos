<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Newsong Cookitz House - Smart Container POS</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --bg-main: #0b0f19;
      --bg-card: #151c2c;
      --border-color: #26334d;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --accent: #10b981;
      --accent-hover: #059669;
      --brand-top: #94a3b8;
      --brand-bottom: #34d399;
    }
    body.light-mode {
      --bg-main: #f8fafc;
      --bg-card: #ffffff;
      --border-color: #e2e8f0;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --accent: #059669;
      --accent-hover: #047857;
      --brand-top: #64748b;
      --brand-bottom: #059669;
    }
    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: system-ui, -apple-system, sans-serif;
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      overflow-x: hidden;
      transition: background-color 0.3s ease, color 0.3s ease;
      box-sizing: border-box;
    }
    *, *:before, *:after { box-sizing: inherit; }
    
    /* MODAL INVERSION RULES */
    body:not(.light-mode) .splash-card,
    body:not(.light-mode) .gate-card,
    body:not(.light-mode) .cart-modal-content {
      background-color: #ffffff !important;
      color: #0f172a !important;
      border-color: #cbd5e1 !important;
    }
    body:not(.light-mode) .splash-card .splash-brand-top,
    body:not(.light-mode) .gate-card p,
    body:not(.light-mode) .cart-modal-header h3,
    body:not(.light-mode) .form-group label,
    body:not(.light-mode) .summary-row {
      color: #475569 !important;
    }
    body:not(.light-mode) .form-input,
    body:not(.light-mode) .form-select,
    body:not(.light-mode) .mode-btn {
      background-color: #f8fafc !important;
      color: #0f172a !important;
      border-color: #cbd5e1 !important;
    }
    body:not(.light-mode) .form-select option {
      background-color: #ffffff !important;
      color: #0f172a !important;
    }
    body:not(.light-mode) .modal-inner-box {
      background-color: #f8fafc !important;
      color: #0f172a !important;
      border-color: #cbd5e1 !important;
    }
    body.light-mode .splash-card,
    body.light-mode .gate-card,
    body.light-mode .cart-modal-content {
      background-color: #1e293b !important;
      color: #f8fafc !important;
      border-color: #334155 !important;
    }
    body.light-mode .splash-card .splash-brand-top,
    body.light-mode .gate-card p,
    body.light-mode .cart-modal-header h3,
    body.light-mode .form-group label,
    body.light-mode .summary-row {
      color: #94a3b8 !important;
    }
    body.light-mode .form-input,
    body.light-mode .form-select,
    body.light-mode .mode-btn {
      background-color: #0f172a !important;
      color: #f8fafc !important;
      border-color: #334155 !important;
    }
    body.light-mode .form-select option {
      background-color: #0f172a !important;
      color: #f8fafc !important;
    }
    body.light-mode .modal-inner-box {
      background-color: #0f172a !important;
      color: #f8fafc !important;
      border-color: #334155 !important;
    }
    
    /* COMPACT THEME TOGGLE BUTTON */
    .theme-toggle-btn {
      background: var(--bg-main);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      border-radius: 6px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      width: 30px;
      height: 30px;
      padding: 0;
      flex-shrink: 0;
    }
    .theme-toggle-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .theme-toggle-btn svg {
      width: 14px;
      height: 14px;
      stroke: currentColor;
    }
    
    /* TOAST & GUIDANCE BANNER */
    .toast-notif {
      position: fixed; top: 20px; right: 20px; z-index: 500;
      transform: translateY(-200%); transition: transform 0.3s ease-in-out;
      background: #0f172a; color: white; padding: 16px 20px; border-radius: 12px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3); display: flex; align-items: center; gap: 12px;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .toast-notif.show { transform: translateY(0); }
    
    .guidance-banner {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-200%); z-index: 500;
      transition: transform 0.3s ease-in-out; background: #f59e0b; color: #0f172a; padding: 14px 20px;
      border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3); display: flex; align-items: center; gap: 12px;
      max-width: 440px; width: 90%; font-weight: 500; border: 1px solid #fbbf24;
    }
    .guidance-banner.show { transform: translateX(-50%) translateY(0); }
    
    /* SPLASH SCREEN */
    #splash-screen {
      position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(11, 15, 25, 0.95); z-index: 200;
      display: flex; align-items: center; justify-content: center; padding: 20px; margin: 0; box-sizing: border-box;
    }
    .splash-card {
      border-radius: 20px; padding: 36px 32px 44px 32px; max-width: 480px; width: 100%; margin: auto; text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3); position: relative;
    }
    .splash-top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; width: 100%; }
    .splash-brand-top { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; }
    .splash-brand-main { font-size: 1.75rem; font-weight: 800; color: var(--accent); margin: 6px 0 14px 0; }
    .splash-desc { font-size: 0.85rem; line-height: 1.5; margin-bottom: 28px; }
    .splash-btn {
      background: linear-gradient(135deg, var(--accent), #059669); color: white; border: none; padding: 14px 24px;
      border-radius: 12px; font-weight: bold; font-size: 0.9rem; cursor: pointer;
      display: inline-flex; align-items: center; gap: 10px; transition: all 0.25s ease; width: 100%; justify-content: center;
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);
    }
    .splash-btn:hover { background: var(--accent-hover); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5); }
    
    /* SERVICE MODE GATE MODAL */
    #service-gate-modal { 
      position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(11, 15, 25, 0.9); z-index: 150; 
      display: none; align-items: center; justify-content: center; padding: 20px; margin: 0; box-sizing: border-box; 
    }
    .gate-card { 
      border-radius: 16px; padding: 28px; max-width: 440px; width: 100%; margin: auto; 
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3); text-align: center; position: relative; 
    }
    .gate-card h2 { font-size: 1.1rem; font-weight: 700; margin: 0 0 10px 0; }
    .gate-card p { font-size: 0.8rem; margin-bottom: 20px; line-height: 1.4; }
    .mode-options { display: flex; flex-direction: column; gap: 10px; width: 100%; }
    .mode-btn { 
      border-radius: 8px; padding: 12px 16px; font-weight: bold; font-size: 0.85rem; cursor: pointer; 
      transition: all 0.2s; text-align: left; display: flex; justify-content: space-between; align-items: center; 
      border: 1px solid var(--border-color); width: 100%; 
    }
    .mode-btn:hover { background: var(--accent) !important; color: white !important; border-color: var(--accent) !important; }
    
    /* MAIN APP LAYOUT */
    #main-app { display: none; width: 100%; min-height: 100vh; flex-direction: column; align-items: center; }
    header {
      position: sticky; top: 0; z-index: 90;
      background: var(--bg-card); border-bottom: 1px solid var(--border-color);
      padding: 14px 0; backdrop-filter: blur(8px); width: 100%; display: flex; justify-content: center;
    }
    .header-inner { max-width: 1100px; margin: 0 auto; padding: 0 20px; display: flex; justify-content: space-between; align-items: center; width: 100%; }
    
    .brand-container { display: flex; flex-direction: column; text-align: left; }
    .logo-top { font-size: 0.65rem; font-weight: 700; color: var(--brand-top); text-transform: uppercase; letter-spacing: 1.5px; }
    .logo-bottom { font-size: 1.05rem; font-weight: 800; color: var(--brand-bottom); letter-spacing: 0.5px; margin-top: 2px; }
    
    .header-actions { display: flex; align-items: center; gap: 8px; }
    .mode-indicator { background: rgba(16, 185, 129, 0.15); color: var(--accent); border: 1px solid rgba(16, 185, 129, 0.3); padding: 5px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; white-space: nowrap; }
    
    .header-tray-btn {
      background: var(--bg-main); border: 1px solid var(--border-color);
      padding: 6px 10px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 6px;
      transition: all 0.2s ease; color: var(--text-main); position: relative;
    }
    .header-tray-btn:hover { border-color: var(--accent); }
    .cart-icon-svg { width: 15px; height: 15px; fill: var(--text-main); }
    .cart-counter-badge {
      position: absolute; top: -5px; right: -5px; background: var(--accent); color: white;
      font-size: 0.6rem; font-weight: 800; padding: 2px 5px; border-radius: 9999px;
    }
    .main-container { max-width: 1100px; margin: 0 auto; padding: 24px 16px; width: 100%; flex: 1; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; }
    .banner { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px 24px; margin-bottom: 24px; width: 100%; max-width: 1000px; text-align: left; }
    .banner h2 { margin: 0 0 6px 0; color: var(--brand-bottom); font-size: 1.1rem; }
    .banner p { margin: 0; color: var(--text-muted); font-size: 0.8rem; line-height: 1.4; }
    
    /* AUTOMATIC CONTAINER BUILDER SECTION */
    #container-builder-section { display: none; margin-bottom: 24px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 18px 22px; width: 100%; max-width: 1000px; text-align: left; }
    .container-header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 10px; width: 100%; }
    .container-header-row h3 { margin: 0; font-size: 0.95rem; color: var(--text-main); }
    
    .add-container-btn { 
      background: linear-gradient(135deg, var(--accent), #059669); 
      color: white; border: none; padding: 8px 16px; border-radius: 8px; 
      font-size: 0.75rem; font-weight: 700; cursor: pointer; display: inline-flex; 
      align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
      transition: all 0.25s ease; 
    }
    .add-container-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4); background: var(--accent-hover); }
    .containers-list { display: flex; flex-direction: column; gap: 10px; margin-top: 6px; width: 100%; }
    .container-card-box { background: var(--bg-main); border: 1px solid var(--accent); padding: 14px; border-radius: 10px; font-size: 0.8rem; width: 100%; box-shadow: 0 0 0 1px var(--accent); }
    .container-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; flex-wrap: wrap; gap: 8px; width: 100%; }
    .container-items-preview { font-size: 0.75rem; color: var(--text-muted); padding: 6px 0 0 0; border-top: 1px dashed var(--border-color); margin-top: 6px; }
    
    /* SEARCH BAR & CATEGORIES */
    .search-bar-container { width: 100%; max-width: 1000px; margin-bottom: 16px; }
    .categories { display: flex; justify-content: center; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: 24px; width: 100%; max-width: 1000px; }
    .cat-btn { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-muted); padding: 7px 14px; border-radius: 8px; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .cat-btn:hover { background: var(--bg-main); color: var(--text-main); border-color: var(--text-muted); }
    .cat-btn.active { background: var(--accent); color: white; border-color: var(--accent); }
    .menu-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; justify-content: center; width: 100%; max-width: 1000px; }
    .menu-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; width: 100%; text-align: left; }
    .menu-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 6px; width: 100%; }
    .menu-title { font-size: 0.85rem; font-weight: bold; color: var(--text-main); margin: 0; }
    .menu-cat { font-size: 0.6rem; background: var(--bg-main); color: var(--brand-bottom); padding: 2px 5px; border-radius: 4px; font-family: monospace; text-transform: uppercase; border: 1px solid var(--border-color); white-space: nowrap; }
    .menu-desc { font-size: 0.75rem; color: var(--text-muted); margin: 8px 0 14px 0; line-height: 1.4; min-height: 32px; }
    
    .menu-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); padding-top: 12px; width: 100%; }
    .price { font-weight: 800; color: var(--brand-bottom); font-size: 0.9rem; }
    
    .stepper { display: flex; align-items: center; background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 6px; overflow: hidden; }
    .step-btn { background: var(--bg-card); color: var(--text-main); border: none; width: 30px; height: 30px; font-weight: bold; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .step-btn:hover { background: var(--accent); color: white; }
    .step-count { padding: 0 10px; font-size: 0.8rem; font-weight: bold; color: var(--text-main); min-width: 18px; text-align: center; }
    
    /* FLOATING WHATSAPP BUTTON */
    .whatsapp-floating-btn {
      position: fixed; bottom: 24px; right: 24px; width: 50px; height: 50px;
      background: #22c55e; border-radius: 12px; display: flex; align-items: center; justify-content: center;
      color: white; text-decoration: none; box-shadow: 0 10px 25px rgba(34, 197, 94, 0.3);
      z-index: 90; transition: transform 0.2s, background 0.2s, bottom 0.3s ease;
    }
    .whatsapp-floating-btn.lifted { bottom: 84px; }
    .whatsapp-floating-btn:hover { background: #16a34a; transform: translateY(-2px); }
    .whatsapp-svg { width: 26px; height: 26px; fill: white; }
    
    /* REFINED CHECKOUT POP-UP MODAL */
    #cart-modal { 
      position: fixed; inset: 0; width: 100vw; height: 100vh; 
      background: rgba(11, 15, 25, 0.85); backdrop-filter: blur(6px); 
      z-index: 100; display: none; align-items: center; justify-content: center; 
      padding: 16px; box-sizing: border-box; text-align: left; 
    }
    .cart-modal-content { 
      border-radius: 18px; padding: 24px; max-width: 520px; width: 100%; 
      margin: auto; box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4); 
      max-height: 90vh; display: flex; flex-direction: column; 
      box-sizing: border-box; position: relative;
    }
    .cart-modal-header { 
      display: flex; justify-content: space-between; align-items: center; 
      border-bottom: 1px solid var(--border-color); padding-bottom: 12px; 
      margin-bottom: 14px; width: 100%; flex-shrink: 0; 
    }
    .cart-modal-header h3 { margin: 0; font-size: 1.1rem; font-weight: 800; }
    .close-modal-btn { 
      background: var(--bg-main); border: 1px solid var(--border-color); 
      color: var(--text-muted); width: 32px; height: 32px; border-radius: 8px; 
      font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: all 0.2s;
    }
    .close-modal-btn:hover { color: var(--text-main); border-color: var(--accent); }
    
    .form-group { margin-bottom: 12px; width: 100%; text-align: left; }
    .form-group label { display: block; font-size: 0.7rem; font-weight: bold; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
    .form-input, .form-select { width: 100%; padding: 10px 12px; border-radius: 8px; font-size: 0.85rem; border: 1px solid var(--border-color); box-sizing: border-box; }
    .form-input:focus, .form-select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.15); }
    
    .modal-inner-box {
      background: var(--bg-main);
      border: 1px dashed var(--border-color);
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 12px;
      font-size: 0.8rem;
    }
    .cart-items-list { 
      overflow-y: auto; 
      max-height: 35vh; 
      margin-bottom: 12px; 
      border-top: 1px dashed var(--border-color); 
      border-bottom: 1px dashed var(--border-color); 
      padding: 8px 0; 
      width: 100%; 
    }
    .cart-container-row { padding: 8px 0; border-bottom: 1px solid var(--border-color); font-size: 0.8rem; width: 100%; text-align: left; }
    .cart-container-row:last-child { border-bottom: none; }
    
    .cart-form-scrollable {
      overflow-y: auto;
      max-height: 32vh;
      padding-right: 4px;
      margin-bottom: 10px;
      width: 100%;
    }
    .cart-summary-box { border-top: 1px solid var(--border-color); padding-top: 12px; width: 100%; flex-shrink: 0; }
    .summary-row { display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 6px; width: 100%; }
    .summary-total { display: flex; justify-content: space-between; font-size: 0.95rem; font-weight: 800; color: var(--brand-bottom); border-top: 1px solid var(--border-color); padding-top: 10px; margin-top: 6px; width: 100%; }
    
    .checkout-action-btn { width: 100%; background: linear-gradient(135deg, var(--accent), #059669); color: white; border: none; padding: 13px; border-radius: 10px; font-weight: bold; font-size: 0.9rem; cursor: pointer; margin-top: 10px; transition: all 0.2s; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35); }
    .checkout-action-btn:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5); }
    
    @keyframes slideUp {
      from { transform: translateY(100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    #notification-ticker {
      position: fixed; bottom: 0; left: 0; right: 0; 
      background: linear-gradient(135deg, var(--accent), #059669); color: white;
      padding: 12px 24px; font-size: 0.8rem; font-weight: bold; text-align: center; 
      z-index: 300; display: none; align-items: center; justify-content: center; gap: 14px;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.3);
      animation: slideUp 0.3s ease-out forwards;
    }
    @media (max-width: 768px) {
      .header-inner { padding: 0 16px; }
      .main-container { padding: 16px 12px; }
      .menu-grid { grid-template-columns: 1fr; }
      .cart-modal-content { padding: 18px; max-height: 92vh; }
    }
  </style>
</head>
<body data-controller="checkout">
  <!-- TOAST NOTIFICATION & GUIDANCE BANNER -->
  <div id="cart-toast" class="toast-notif">
    <div style="background: #10b981; color: white; border-radius: 9999px; padding: 4px;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
    </div>
    <div>
      <p style="margin: 0; font-size: 0.85rem; font-weight: 600;">Added to your container!</p>
      <p id="toast-item-name" style="margin: 0; font-size: 0.75rem; color: #94a3b8;">Item successfully added.</p>
    </div>
  </div>
  <!-- STYLED CANCELLATION TOAST NOTIFICATION -->
  <div id="cancel-toast" class="toast-notif" style="border-color: rgba(239, 68, 68, 0.3);">
    <div style="background: #ef4444; color: white; border-radius: 9999px; padding: 4px;">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </div>
    <div>
      <p style="margin: 0; font-size: 0.85rem; font-weight: 600;">Order Cancelled</p>
      <p style="margin: 0; font-size: 0.75rem; color: #94a3b8;">Your order was successfully cancelled within the 1-minute window.</p>
    </div>
  </div>
  
  <div id="error-banner" class="guidance-banner">
    <svg style="width: 24px; height: 24px; flex-shrink: 0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    <div>
      <p style="margin: 0; font-size: 0.65rem; font-weight: bold; text-transform: uppercase; color: #78350f;">Smart Combination Rule</p>
      <p id="error-message-text" style="margin: 2px 0 0 0; font-size: 0.8rem;">Let's pair your items nicely for a wonderful meal!</p>
    </div>
  </div>
  <!-- 1. SPLASH SCREEN -->
  <div id="splash-screen">
    <div class="splash-card">
      <div class="splash-top-bar">
        <span class="splash-brand-top">Welcome to</span>
        <button class="theme-toggle-btn" onclick="toggleTheme()" title="Toggle Dark/Light Mode"></button>
      </div>
      <h1 class="splash-brand-main">Newsong Cookitz House</h1>
      <p class="splash-desc">Experience authentic, fresh Buka delicacies prepared with perfection. Select below to begin your order.</p>
      <button class="splash-btn" onclick="openServiceGate()">
        <span>Click to View Menu</span>
        <span>&rarr;</span>
      </button>
    </div>
  </div>
  <!-- 2. SERVICE MODE GATE MODAL -->
  <div id="service-gate-modal">
    <div class="gate-card">
      <div class="splash-top-bar">

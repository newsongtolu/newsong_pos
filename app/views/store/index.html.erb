    function renderMenu() {
      const grid = document.getElementById('menu-items-grid');
      if (!grid) return;
      grid.innerHTML = '';
      menuItems.forEach(item => {
        const card = document.createElement('div');
        card.className = 'menu-card';
        card.dataset.category = item.category;
        card.dataset.id = item.id;
        card.dataset.name = item.name;
        card.dataset.price = item.price;
        const formattedPrice = `₦${item.price.toLocaleString()}`;
        card.innerHTML = `
          <div>
            <div class="menu-header">
              <h3 class="menu-title">${item.name}</h3>
              <span class="menu-cat">${item.category}</span>
            </div>
            <p class="menu-desc">${item.desc}</p>
          </div>
          <div class="menu-footer">
            <span class="price">${formattedPrice}</span>
            <div class="stepper">
              <button class="step-btn decrease">-</button>
              <span class="step-count">0</span>
              <button class="step-btn increase">+</button>
            </div>
          </div>
        `;
        grid.appendChild(card);
      });
      attachStepperEvents();
    }
    
    function filterMenuSearch() {
      const searchInput = document.getElementById('menu-search-input');
      if (!searchInput) return;
      const query = searchInput.value.toLowerCase().trim();
      const activeCatBtn = document.querySelector('.cat-btn.active');
      const selectedCat = activeCatBtn ? activeCatBtn.dataset.category : 'all';
      
      document.querySelectorAll('.menu-card').forEach(card => {
        const name = card.dataset.name.toLowerCase();
        const descElement = card.querySelector('.menu-desc');
        const desc = descElement ? descElement.textContent.toLowerCase() : '';
        const cat = card.dataset.category;
        
        const matchesSearch = name.includes(query) || desc.includes(query);
        const matchesCategory = (selectedCat === 'all' || cat === selectedCat);
        
        if (matchesSearch && matchesCategory) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }
    

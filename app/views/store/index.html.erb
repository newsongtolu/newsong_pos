    function attachStepperEvents() {
      document.querySelectorAll('.menu-card').forEach(card => {
        const id = card.dataset.id;
        const name = card.dataset.name;
        const price = parseFloat(card.dataset.price);
        const category = card.dataset.category;
        
        const countSpan = card.querySelector('.step-count');
        const incBtn = card.querySelector('.increase');
        const decBtn = card.querySelector('.decrease');
        if (!incBtn || !decBtn || !countSpan) return;
        const newInc = incBtn.cloneNode(true);
        const newDec = decBtn.cloneNode(true);
        incBtn.parentNode.replaceChild(newInc, incBtn);
        decBtn.parentNode.replaceChild(newDec, decBtn);
        
        newInc.addEventListener('click', () => {
          const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
          
          if (needsContainers) {
            const isEmptyContainer = Object.keys(currentContainer.items).length === 0;
            if (isEmptyContainer) {
              if (category === 'Special Packages') {
                currentContainer.packaging = 'Special Package';
                currentContainer.packagingPrice = 0;
              } else if (category === 'Solids (Swallow)') {
                currentContainer.packaging = 'Double Container';
                currentContainer.packagingPrice = 1000;
              } else {
                currentContainer.packaging = 'Standard Container';
                currentContainer.packagingPrice = 500;
              }
            }
            const existingItems = Object.values(currentContainer.items);
            const hasCategory = (cat) => existingItems.some(i => {
              const itemObj = menuItems.find(m => m.name === i.name);
              return itemObj && itemObj.category === cat;
            });
            
            if (currentContainer.packaging === 'Special Package' && category !== 'Drinks' && category !== 'Special Packages') {
              showFriendlyNotice('Special Package containers can only take drinks as add-ons!');
              return;
            } else if (currentContainer.packaging === 'Double Container' && ['Rice & Grains', 'Special Packages', 'Yam', 'Beans'].includes(category)) {
              showFriendlyNotice('Swallow (Double Container) cannot contain Rice, Yam, Beans, or Special Packages!');
              return;
            } else if (currentContainer.packaging === 'Standard Container' && category === 'Solids (Swallow)') {
              showFriendlyNotice('Swallow requires a Double Container and cannot be mixed with Rice/Yam/Beans!');
              return;
            }
            
            if (category === 'Rice & Grains') {
              if (hasCategory('Yam')) {
                showFriendlyNotice('You cannot combine Rice and Yam in the same container!');
                return;
              }
              if (hasCategory('Beans') && !name.includes('Rice and Beans')) {
                showFriendlyNotice('Standalone rice cannot be mixed with separate beans in the same container!');
                return;
              }
            }
            if (category === 'Yam' && (hasCategory('Rice & Grains' ) || hasCategory('Beans'))) {
              showFriendlyNotice('Yam cannot be combined with Rice or Beans in the same container!');
              return;
            }
            if (category === 'Beans' && hasCategory('Yam')) {
              showFriendlyNotice('Beans cannot be combined with Yam in the same container!');
              return;
            }
            if (!currentContainer.items[id]) {
              currentContainer.items[id] = { name, price, qty: 0 };
            }
            currentContainer.items[id].qty++;
            countSpan.textContent = currentContainer.items[id].qty;
            updateActiveContainerUI();
            showToast(name);
          } else {
            if (!window.dineInCart) window.dineInCart = {};
            if (!window.dineInCart[id]) window.dineInCart[id] = { name, price, qty: 0 };
            window.dineInCart[id].qty++;
            countSpan.textContent = window.dineInCart[id].qty;
            updateGlobalCartState();
            showToast(name);
          }
        });
        
        newDec.addEventListener('click', () => {
          const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
          if (needsContainers) {
            if (currentContainer.items[id] && currentContainer.items[id].qty > 0) {
              currentContainer.items[id].qty--;
              if (currentContainer.items[id].qty === 0) {
                delete currentContainer.items[id];
                countSpan.textContent = '0';
              } else {
                countSpan.textContent = currentContainer.items[id].qty;
              }
              updateActiveContainerUI();
            }
          } else {
            if (window.dineInCart && window.dineInCart[id] && window.dineInCart[id].qty > 0) {
              window.dineInCart[id].qty--;
              if (window.dineInCart[id].qty === 0) {
                delete window.dineInCart[id];
                countSpan.textContent = '0';
              } else {
                countSpan.textContent = window.dineInCart[id].qty;
              }
              updateGlobalCartState();
            }
          }
        });
      });
    }
    
    function updateGlobalCartState() {
      const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
      let count = 0;
      if (needsContainers) {
        count = submittedContainers.length + (Object.keys(currentContainer.items).length > 0 ? 1 : 0);
      } else {
        if (window.dineInCart) {
          Object.values(window.dineInCart).forEach(i => count += i.qty);
        }
      }
      const badge = document.getElementById('header-cart-count');
      if (badge) badge.textContent = count;
    }
    
    function handlePaymentMethodChange() {
      const paymentMethodSelect = document.getElementById('payment-method');
      if (!paymentMethodSelect) return;
      const paymentMethod = paymentMethodSelect.value;
      const splitContainer = document.getElementById('split-payment-container');
      const bankDetailsBox = document.getElementById('bank-transfer-details-box');
      const checkoutBtn = document.getElementById('modal-checkout-btn');
      const isOnlineOrder = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Home Delivery');
      
      if (splitContainer) splitContainer.style.display = (paymentMethod === 'Split Payment') ? 'block' : 'none';
      if (bankDetailsBox) bankDetailsBox.style.display = (paymentMethod === 'Bank Transfer' && !isOnlineOrder) ? 'block' : 'none';
      
      if (checkoutBtn) {
        if (paymentMethod === 'Paystack Link') {
          checkoutBtn.textContent = editingOrderId ? 'Update Order via Paystack Link' : 'Proceed to Paystack Link';
        } else {
          checkoutBtn.textContent = editingOrderId ? 'Update Order Successfully' : 'Complete Secure Order';
        }
      }
    }
    
    function validateSplitAmounts() {
      const subtotal = calculateTotalSum();
      const amt1Input = document.getElementById('split-amount-1');
      const amt2Input = document.getElementById('split-amount-2');
      const errorMsg = document.getElementById('split-error-msg');
      if (!amt1Input || !amt2Input || !errorMsg) return true;
      const amt1 = parseFloat(amt1Input.value) || 0;
      const amt2 = parseFloat(amt2Input.value) || 0;
      if ((amt1 + amt2) !== subtotal) {
        errorMsg.style.display = 'block';
        return false;
      } else {
        errorMsg.style.display = 'none';
        return true;
      }
    }
    
    function calculateTotalSum() {
      let subtotal = 0;
      const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
      if (needsContainers) {
        let allContainersToCheck = [...submittedContainers];
        if (Object.keys(currentContainer.items).length > 0) {
          allContainersToCheck.push(currentContainer);
        }
        allContainersToCheck.forEach(c => {
          const itemsSum = Object.values(c.items).reduce((sum, i) => sum + (i.price * i.qty), 0);
          subtotal += itemsSum + c.packagingPrice;
        });
      } else {
        if (window.dineInCart) {
          Object.values(window.dineInCart).forEach(item => {
            subtotal += item.price * item.qty;
          });
        }
      }
      let deliveryFee = 0;
      const isRemoteOrDelivery = (currentServiceMode === 'Home Delivery' || currentServiceMode === 'Online Takeaway');
      if (isRemoteOrDelivery) {
        const feeSelect = document.getElementById('delivery-location-select');
        deliveryFee = feeSelect ? (parseInt(feeSelect.value) || 500) : 500;
        const feeEl = document.getElementById('modal-delivery-fee');
        if (feeEl) feeEl.textContent = '₦' + deliveryFee.toLocaleString();
      }
      return subtotal + deliveryFee;
    }
    
    function updateGrandTotal() {
      let subtotal = 0;
      const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
      if (needsContainers) {
        let allContainersToCheck = [...submittedContainers];
        if (Object.keys(currentContainer.items).length > 0) {
          allContainersToCheck.push(currentContainer);
        }
        allContainersToCheck.forEach(c => {
          const itemsSum = Object.values(c.items).reduce((sum, i) => sum + (i.price * i.qty), 0);
          subtotal += itemsSum + c.packagingPrice;
        });
      } else {
        if (window.dineInCart) {
          Object.values(window.dineInCart).forEach(item => {
            subtotal += item.price * item.qty;
          });
        }
      }
      let deliveryFee = 0;
      const isRemoteOrDelivery = (currentServiceMode === 'Home Delivery' || currentServiceMode === 'Online Takeaway');
      if (isRemoteOrDelivery) {
        const feeSelect = document.getElementById('delivery-location-select');
        deliveryFee = feeSelect ? (parseInt(feeSelect.value) || 500) : 500;
        const feeEl = document.getElementById('modal-delivery-fee');
        if (feeEl) feeEl.textContent = '₦' + deliveryFee.toLocaleString();
      }
      const subtotalEl = document.getElementById('modal-subtotal');
      const grandTotalEl = document.getElementById('modal-grand-total');
      if (subtotalEl) subtotalEl.textContent = '₦' + subtotal.toLocaleString();
      if (grandTotalEl) grandTotalEl.textContent = '₦' + (subtotal + deliveryFee).toLocaleString();
    }
    
    function renderCartModal() {
      const listContainer = document.getElementById('cart-items-list');
      const emptyMsg = document.getElementById('cart-empty-msg');
      const activeContent = document.getElementById('cart-active-content');
      const modalHeaderTitle = document.getElementById('modal-header-title');
      const cartFormSection = document.getElementById('cart-form-scrollable-section');
      if (!listContainer || !emptyMsg || !activeContent) return;
      
      if (editingOrderId) {
        if (modalHeaderTitle) modalHeaderTitle.textContent = `Edit Order #${editingOrderId} & Add Items`;
        if (cartFormSection) cartFormSection.style.display = 'none';
      } else {
        if (modalHeaderTitle) modalHeaderTitle.textContent = 'Order Tray & Checkout';
        if (cartFormSection) cartFormSection.style.display = 'block';
      }
      
      listContainer.innerHTML = '';
      
      const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
      let allContainersToCheck = [...submittedContainers];
      if (needsContainers && Object.keys(currentContainer.items).length > 0) {
        allContainersToCheck.push(currentContainer);
      }
      
      let hasItems = false;
      if (needsContainers) {
        hasItems = allContainersToCheck.length > 0;
        if (hasItems) {
          allContainersToCheck.forEach((c, index) => {
            const itemStrs = Object.values(c.items).map(i => `${i.name} (x${i.qty})`).join(', ');
            const containerTotal = Object.values(c.items).reduce((sum, i) => sum + (i.price * i.qty), 0) + c.packagingPrice;
            
            const row = document.createElement('div');
            row.className = 'cart-container-row';
            row.innerHTML = `
              <div style="font-weight: bold; color: var(--brand-bottom);">Container #${index + 1} (${c.packaging})</div>
              <div style="font-size: 0.75rem; color: var(--text-muted);">${itemStrs}</div>
              <div style="display: flex; justify-content: space-between; margin-top: 4px; font-weight: 600;">
                <span>Container Subtotal + Pack</span>
                <span>₦${containerTotal.toLocaleString()}</span>
              </div>
            `;
            listContainer.appendChild(row);
          });
        }
      } else {
        hasItems = window.dineInCart && Object.keys(window.dineInCart).length > 0;
        if (hasItems) {
          Object.values(window.dineInCart).forEach(item => {
            const row = document.createElement('div');
            row.className = 'cart-container-row';
            row.innerHTML = `
              <div style="display: flex; justify-content: space-between;">
                <span>${item.name} (x${item.qty})</span>
                <span style="font-weight: bold; color: var(--brand-bottom);">₦${(item.price * item.qty).toLocaleString()}</span>
              </div>
            `;
            listContainer.appendChild(row);
          });
        }
      }
      if (!hasItems) {
        emptyMsg.style.display = 'block';
        activeContent.style.display = 'none';
        return;
      }
      emptyMsg.style.display = 'none';
      activeContent.style.display = 'flex';
      
      const isRemoteOrDelivery = (currentServiceMode === 'Home Delivery' || currentServiceMode === 'Online Takeaway');
      if (!editingOrderId) {
        const locField = document.getElementById('delivery-location-field');
        const addrField = document.getElementById('delivery-address-field');
        if (locField) locField.style.display = isRemoteOrDelivery ? 'block' : 'none';
        if (addrField) addrField.style.display = isRemoteOrDelivery ? 'block' : 'none';
      }
      const feeRow = document.getElementById('summary-fee-row');
      if (feeRow) feeRow.style.display = isRemoteOrDelivery ? 'flex' : 'none';
      
      const paymentSelect = document.getElementById('payment-method');
      if (paymentSelect) {
        paymentSelect.innerHTML = '';
        if (currentServiceMode === 'Dine-In' || currentServiceMode === 'Physical Takeaway') {
          paymentSelect.innerHTML = `
            <option value="Cash">Cash</option>
            <option value="Bank Transfer">Bank Transfer</option>
            <option value="POS">POS</option>
            <option value="Split Payment">Split Payment</option>
          `;
        } else {
          paymentSelect.innerHTML = `
            <option value="Paystack Link">Paystack Link</option>
          `;
        }
        handlePaymentMethodChange();
      }
      
      updateGrandTotal();
    }
    
    function submitOrder() {
      const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
      if (needsContainers && Object.keys(currentContainer.items).length > 0) {
        submittedContainers.push(JSON.parse(JSON.stringify(currentContainer)));
        currentContainer = { packaging: 'Standard Container', packagingPrice: 500, items: {} };
      }
      
      let name = '';
      let phone = '';
      let email = '';
      let paymentMethod = 'Cash';
      let address = '';
      
      if (!editingOrderId) {
        const nameEl = document.getElementById('cust-name');
        const phoneEl = document.getElementById('cust-phone');
        const emailEl = document.getElementById('cust-email');
        const paymentEl = document.getElementById('payment-method');
        const addressEl = document.getElementById('cust-address');
        name = nameEl ? nameEl.value.trim() : '';
        phone = phoneEl ? phoneEl.value.trim() : '';
        email = emailEl ? emailEl.value.trim() : '';
        paymentMethod = paymentEl ? paymentEl.value : 'Cash';
        const isRemoteOrDelivery = (currentServiceMode === 'Home Delivery' || currentServiceMode === 'Online Takeaway');
        address = (isRemoteOrDelivery && addressEl) ? addressEl.value.trim() : '';
        
        if (!name || !phone) {
          alert('Please enter your Customer Name and WhatsApp Phone Number.');
          return;
        }
        if (phone.length !== 11 || !/^\d+$/.test(phone)) {
          alert('Please enter a valid strict 11-digit WhatsApp phone number.');
          return;
        }
        if (isRemoteOrDelivery && !address) {
          alert('Please enter your specific delivery street address.');
          return;
        }
        if (paymentMethod === 'Split Payment' && !validateSplitAmounts()) {
          alert('Please ensure split payment amounts correctly equal the grand total.');
          return;
        }
      } else {
        name = 'Existing Customer (Order #' + editingOrderId + ')';
        phone = '00000000000';
      }
      
      const grandTotalEl = document.getElementById('modal-grand-total');
      const subtotalEl = document.getElementById('modal-subtotal');
      const deliveryFeeEl = document.getElementById('modal-delivery-fee');
      const grandTotal = grandTotalEl ? grandTotalEl.textContent : '₦0';
      const subtotalVal = subtotalEl ? subtotalEl.textContent : '₦0';
      const isRemoteOrDeliveryCheck = (currentServiceMode === 'Home Delivery' || currentServiceMode === 'Online Takeaway');
      const deliveryFeeVal = (isRemoteOrDeliveryCheck && deliveryFeeEl) ? deliveryFeeEl.textContent : '₦0';
      const orderId = editingOrderId ? editingOrderId : ('NSC-' + Math.floor(100000 + Math.random() * 900000));
      
      pendingOrderData = {
        order: {
          order_id: orderId,
          customer_name: name,
          phone: phone,
          email: email,
          service_mode: currentServiceMode,
          fulfillment_type: currentServiceMode,
          payment_method: paymentMethod,
          delivery_address: address,
          subtotal: subtotalVal,
          delivery_fee: deliveryFeeVal,
          grand_total: grandTotal,
          containers: submittedContainers,
          dine_in_items: window.dineInCart || {}
        }
      };
      
      submittedContainers = [];
      window.dineInCart = {};
      currentContainer = { packaging: 'Standard Container', packagingPrice: 500, items: {} };
      
      document.querySelectorAll('.step-count').forEach(span => { span.textContent = '0'; });
      if (!editingOrderId) {
        if (document.getElementById('cust-name')) document.getElementById('cust-name').value = '';
        if (document.getElementById('cust-phone')) document.getElementById('cust-phone').value = '';
        if (document.getElementById('cust-email')) document.getElementById('cust-email').value = '';
        if (document.getElementById('cust-address')) document.getElementById('cust-address').value = '';
      }
      
      if (needsContainers) updateActiveContainerUI();
      updateGlobalCartState();
      closeCheckoutModal();
      
      const receiptBody = document.getElementById('receipt-body');
      if (receiptBody) {
        receiptBody.innerHTML = generateReceiptHTML(pendingOrderData.order);
      }
      if (editingOrderId) {
        if (pendingOrderData) {
          sendOrderToBackend(pendingOrderData);
          pendingOrderData = null;
        }
        return;
      }
      
      const receiptModal = document.getElementById('receipt-modal');
      if (receiptModal) receiptModal.style.display = 'flex';
      startCancellationCountdown();
    }
    
    function generateReceiptHTML(order) {
      let itemsHTML = '';
      if (order.service_mode === 'Online Takeaway' || order.service_mode === 'Physical Takeaway' || order.service_mode === 'Home Delivery') {
        order.containers.forEach((c, idx) => {
          const itemsList = Object.values(c.items).map(i => `${i.name} (x${i.qty}) - ₦${(i.price * i.qty).toLocaleString()}`).join('<br>');
          const cTotal = Object.values(c.items).reduce((sum, i) => sum + (i.price * i.qty), 0) + c.packagingPrice;
          itemsHTML += `<div style="margin-bottom: 8px; border-bottom: 1px dashed var(--border-color); padding-bottom: 6px;">
            <strong>Container #${idx + 1} (${c.packaging})</strong><br>
            ${itemsList}<br>
            <span style="color: var(--brand-bottom);">Container Total: ₦${cTotal.toLocaleString()}</span>
          </div>`;
        });
      } else {
        Object.values(order.dine_in_items).forEach(item => {
          itemsHTML += `<div>${item.name} x${item.qty} - ₦${(item.price * item.qty).toLocaleString()}</div>`;
        });
      }
      
      return `
        <div style="text-align: center; border-bottom: 2px dashed var(--border-color); padding-bottom: 12px; margin-bottom: 12px;">
          <h2 style="margin: 0; color: var(--brand-bottom); font-size: 1.1rem;">Newsong Cookitz House</h2>
          <p style="margin: 2px 0; font-size: 0.75rem; color: var(--text-muted);">Smart Container POS Receipt</p>
          <p style="margin: 2px 0; font-size: 0.75rem;">Order ID: <strong>${order.order_id}</strong></p>
          <p style="margin: 2px 0; font-size: 0.75rem;">Date: ${new Date().toLocaleString()}</p>
        </div>
        <div style="margin-bottom: 10px; font-size: 0.75rem;">
          <p style="margin: 2px 0;"><strong>Customer:</strong> ${order.customer_name}</p>
          <p style="margin: 2px 0;"><strong>Phone:</strong> ${order.phone}</p>
          <p style="margin: 2px 0;"><strong>Service Mode:</strong> ${order.service_mode}</p>
          ${order.delivery_address ? `<p style="margin: 2px 0;"><strong>Address:</strong> ${order.delivery_address}</p>` : ''}
          <p style="margin: 2px 0;"><strong>Payment:</strong> ${order.payment_method}</p>
        </div>
        <div style="border-top: 1px dashed var(--border-color); border-bottom: 1px dashed var(--border-color); padding: 8px 0; margin-bottom: 10px;">
          <div style="font-weight: bold; margin-bottom: 4px; font-size: 0.75rem; text-transform: uppercase;">Order Breakdown</div>
          ${itemsHTML}
        </div>
        <div style="font-size: 0.8rem;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px;"><span>Subtotal:</span> <span>${order.subtotal}</span></div>
          ${order.delivery_fee && order.delivery_fee !== '₦0' ? `<div style="display: flex; justify-content: space-between; margin-bottom: 4px;"><span>Delivery Fee:</span> <span>${order.delivery_fee}</span></div>` : ''}
          <div style="display: flex; justify-content: space-between; font-weight: 800; font-size: 0.9rem; color: var(--brand-bottom); border-top: 1px solid var(--border-color); padding-top: 6px; margin-top: 4px;">
            <span>Grand Total:</span> <span>${order.grand_total}</span>
          </div>
        </div>
      `;
    }
    
    function printReceipt() {
      const receiptBody = document.getElementById('receipt-body');
      if (!receiptBody) return;
      const receiptContent = receiptBody.innerHTML;
      const printWindow = window.open('', '_blank', 'width=600,height=600');
      if (printWindow) {
        printWindow.document.write(`
          <html>
            <head><title>Print E-Receipt - Newsong Cookitz House</title></head>
            <body style="font-family: monospace; padding: 20px; color: #000; background: #fff;">
              ${receiptContent}
              <script>window.print(); window.close();<\/script>
            </body>
          </html>
        `);
        printWindow.document.close();
      }
    }
    
    function startCancellationCountdown() {
      let timeLeft = 60;
      orderCanBeCancelled = true;
      const timerDisplay = document.getElementById('ticker-countdown');
      const ticker = document.getElementById('notification-ticker');
      const whatsappBtn = document.getElementById('whatsapp-btn');
      
      if (ticker) ticker.style.display = 'flex';
      if (whatsappBtn) whatsappBtn.classList.add('lifted');
      if (activeCountdownInterval) clearInterval(activeCountdownInterval);
      
      activeCountdownInterval = setInterval(() => {
        timeLeft--;
        let mins = Math.floor(timeLeft / 60).toString().padStart(2, '0');
        let secs = (timeLeft % 60).toString().padStart(2, '0');
        if (timerDisplay) timerDisplay.textContent = `${mins}:${secs}`;
        
        if (timeLeft <= 0) {
          clearInterval(activeCountdownInterval);
          if (ticker) ticker.style.display = 'none';
          if (whatsappBtn) whatsappBtn.classList.remove('lifted');
          orderCanBeCancelled = false;
          
          if (pendingOrderData) {
            sendOrderToBackend(pendingOrderData);
            pendingOrderData = null;
          }
        }
      }, 1000);
    }
    
    function sendOrderToBackend(orderData) {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
      const endpoint = editingOrderId ? `/cashier/orders/${editingOrderId}` : '/orders';
      const method = editingOrderId ? 'PATCH' : 'POST';
      
      fetch(endpoint, {
        method: method,
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {})
        },
        body: JSON.stringify(orderData)
      })
      .then(async res => {
        const contentType = res.headers.get('content-type');
        let data = {};
        if (contentType && contentType.includes('application/json')) {
          data = await res.json();
        }
        if (!res.ok) {
          throw new Error(data.message || 'Server error occurred while saving order.');
        }
        if (editingOrderId) {
          window.location.href = `/cashier/orders/${editingOrderId}/edit`;
        }
        console.log('Order successfully synced to database:', data);
      })
      .catch(err => {
        console.error('Error syncing order to database:', err);
        if (editingOrderId) {
          window.location.href = `/cashier/orders/${editingOrderId}/edit`;
        }
      });
    }
    
    function cancelActiveOrder() {
      if (!orderCanBeCancelled) return;
      if (activeCountdownInterval) clearInterval(activeCountdownInterval);
      const ticker = document.getElementById('notification-ticker');
      const whatsappBtn = document.getElementById('whatsapp-btn');
      const receiptModal = document.getElementById('receipt-modal');
      if (ticker) ticker.style.display = 'none';
      if (whatsappBtn) whatsappBtn.classList.remove('lifted');
      if (receiptModal) receiptModal.style.display = 'none';
      orderCanBeCancelled = false;
      pendingOrderData = null; 
      
      showCancelToast();
    }
    
    function closeReceiptModal() {
      const receiptModal = document.getElementById('receipt-modal');
      if (receiptModal) receiptModal.style.display = 'none';
      if (editingOrderId) {
        window.location.href = `/cashier/orders/${editingOrderId}/edit`;
      }
    }
    
    window.onload = () => {
      renderMenu();
      updateThemeButtons(document.body.classList.contains('light-mode'));
      
      const urlParams = new URLSearchParams(window.location.search);
      const orderIdParam = urlParams.get('order_id');
      const fulfillmentParam = urlParams.get('fulfillment');
      
      if (orderIdParam) {
        editingOrderId = orderIdParam;
      }
      
      if (fulfillmentParam) {
        selectServiceMode(fulfillmentParam);
      } else if (orderIdParam) {
        selectServiceMode('Dine-In');
      }
    };
  </script>
</body>
</html>
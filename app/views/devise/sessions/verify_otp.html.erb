<div class="min-h-screen flex items-center justify-center bg-gray-900 px-4">
  <div class="max-w-md w-full space-y-8 bg-gray-800 p-8 rounded-2xl shadow-2xl border border-gray-700">
    <div>
      <h2 class="text-center text-3xl font-extrabold text-white tracking-tight">
        Two-Factor Verification
      </h2>
      <p class="mt-2 text-center text-sm text-gray-400">
        Enter the 5-digit verification code sent to your account
      </p>
    </div>

    <% if flash[:alert] %>
      <div class="bg-red-500/10 border border-red-500 text-red-400 px-4 py-3 rounded-xl text-sm" role="alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="bg-emerald-500/10 border border-emerald-500 text-emerald-400 px-4 py-3 rounded-xl text-sm" role="alert">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_with url: confirm_otp_path, method: :post, local: true, class: "mt-8 space-y-6" do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :otp_code, "Verification Code", class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.text_field :otp_code, autofocus: true, maxlength: 5, required: true, class: "w-full text-center tracking-widest text-2xl font-mono px-4 py-3 border border-gray-600 bg-gray-700 text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 placeholder-gray-500", placeholder: "12345" %>
        </div>
      </div>

      <div>
        <%= f.submit "Verify Code", class: "w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors shadow-lg cursor-pointer" %>
      </div>
    <% end %>

    <div class="text-center pt-2 text-sm text-gray-400">
      <%= link_to "Back to sign in", new_user_session_path, class: "text-indigo-400 hover:text-indigo-300 font-medium" %>
    </div>
  </div>
</div>
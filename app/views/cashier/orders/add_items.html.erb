    function renderMenu() {
      const grid = document.getElementById('menu-items-grid');
      if (!grid) return;
      grid.innerHTML = '';
      menuItems.forEach(item => {
        const card = document.createElement('div');
        card.className = 'menu-card';
        card.dataset.category = item.category;
        card.dataset.id = item.id;
        card.dataset.name = item.name;
        card.dataset.price = item.price;
        const formattedPrice = `₦${item.price.toLocaleString()}`;
        card.innerHTML = `
          <div>
            <div class="menu-header">
              <h3 class="menu-title">${item.name}</h3>
              <span class="menu-cat">${item.category}</span>
            </div>
            <p class="menu-desc">${item.desc}</p>
          </div>
          <div class="menu-footer">
            <span class="price">${formattedPrice}</span>
            <div class="stepper">
              <button class="step-btn decrease">-</button>
              <span class="step-count">0</span>
              <button class="step-btn increase">+</button>
            </div>
          </div>
        `;
        grid.appendChild(card);
      });
      attachStepperEvents();
    }
    
    function filterMenuSearch() {
      const searchInput = document.getElementById('menu-search-input');
      if (!searchInput) return;
      const query = searchInput.value.toLowerCase().trim();
      const activeCatBtn = document.querySelector('.cat-btn.active');
      const selectedCat = activeCatBtn ? activeCatBtn.dataset.category : 'all';
      
      document.querySelectorAll('.menu-card').forEach(card => {
        const name = card.dataset.name.toLowerCase();
        const descElement = card.querySelector('.menu-desc');
        const desc = descElement ? descElement.textContent.toLowerCase() : '';
        const cat = card.dataset.category;
        
        const matchesSearch = name.includes(query) || desc.includes(query);
        const matchesCategory = (selectedCat === 'all' || cat === selectedCat);
        
        if (matchesSearch && matchesCategory) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }
    
    function toggleTheme() {
      const isLight = document.body.classList.toggle('light-mode');
      updateThemeButtons(isLight);
    }
    
    function updateThemeButtons(isLight) {
      const sunSvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>`;
      const moonSvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>`;
      
      document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
        btn.innerHTML = isLight ? sunSvg : moonSvg;
        btn.title = isLight ? "Switch to Dark Mode" : "Switch to Light Mode";
      });
    }
    
    function initializeServiceMode(mode) {
      currentServiceMode = mode;
      const activeModeBadge = document.getElementById('active-mode-badge');
      const containerBuilder = document.getElementById('container-builder-section');
      if (activeModeBadge) activeModeBadge.textContent = currentServiceMode;
      
      const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
      if (containerBuilder) containerBuilder.style.display = needsContainers ? 'block' : 'none';
      
      if (needsContainers) {
        updateActiveContainerUI();
      }
    }
    
    function updateActiveContainerUI() {
      const typeLabel = document.getElementById('container-type-label');
      const titleLabel = document.getElementById('active-container-title');
      const preview = document.getElementById('container-items-preview');
      if (!typeLabel || !titleLabel || !preview) return;
      
      let priceText = `₦${currentContainer.packagingPrice.toLocaleString()}`;
      typeLabel.textContent = `Type: ${currentContainer.packaging} (${priceText})`;
      titleLabel.textContent = `Container #${submittedContainers.length + 1} (${currentContainer.packaging} - ${priceText})`;
      
      const itemEntries = Object.values(currentContainer.items);
      if (itemEntries.length === 0) {
        preview.innerHTML = `<strong>Contents:</strong> Empty container. Select items below.`;
      } else {
        preview.innerHTML = `<strong>Contents:</strong> ${itemEntries.map(i => `${i.name} (x${i.qty})`).join(', ')}`;
      }
    }
    
    function finalizeContainer() {
      if (Object.keys(currentContainer.items).length === 0) {
        showFriendlyNotice('This container is empty! Please add at least one item before saving.');
        return;
      }
      submittedContainers.push(JSON.parse(JSON.stringify(currentContainer)));
      currentContainer = { packaging: 'Standard Container', packagingPrice: 500, items: {} };
      updateActiveContainerUI();
      updateGlobalCartState();
      showToast('Container saved successfully!');
    }
    
    function openCheckoutModal() {
      const modal = document.getElementById('cart-modal');
      if (modal) modal.style.display = 'flex';
      renderCartModal();
    }
    
    function closeCheckoutModal() {
      const modal = document.getElementById('cart-modal');
      if (modal) modal.style.display = 'none';
    }
    
    document.querySelectorAll('.cat-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterMenuSearch();
      });
    });
    
    function showToast(itemName) {
      const toast = document.getElementById('cart-toast');
      const itemNameEl = document.getElementById('toast-item-name');
      if (!toast || !itemNameEl) return;
      itemNameEl.innerText = itemName + ' added successfully.';
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }
    
    function showFriendlyNotice(message) {
      const banner = document.getElementById('error-banner');
      const msgText = document.getElementById('error-message-text');
      if (!banner || !msgText) return;
      msgText.innerText = message;
      banner.classList.add('show');
      setTimeout(() => {
        banner.classList.remove('show');
      }, 5000);
    }
    
    function attachStepperEvents() {
      document.querySelectorAll('.menu-card').forEach(card => {
        const id = card.dataset.id;
        const name = card.dataset.name;
        const price = parseFloat(card.dataset.price);
        const category = card.dataset.category;
        
        const countSpan = card.querySelector('.step-count');
        const incBtn = card.querySelector('.increase');
        const decBtn = card.querySelector('.decrease');
        if (!incBtn || !decBtn || !countSpan) return;
        const newInc = incBtn.cloneNode(true);
        const newDec = decBtn.cloneNode(true);
        incBtn.parentNode.replaceChild(newInc, incBtn);
        decBtn.parentNode.replaceChild(newDec, decBtn);
        
        newInc.addEventListener('click', () => {
          const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
          
          if (needsContainers) {
            const isEmptyContainer = Object.keys(currentContainer.items).length === 0;
            if (isEmptyContainer) {
              if (category === 'Special Packages') {
                currentContainer.packaging = 'Special Package';
                currentContainer.packagingPrice = 0;
              } else if (category === 'Solids (Swallow)') {
                currentContainer.packaging = 'Double Container';
                currentContainer.packagingPrice = 1000;
              } else {
                currentContainer.packaging = 'Standard Container';
                currentContainer.packagingPrice = 500;
              }
            }
            if (!currentContainer.items[id]) {
              currentContainer.items[id] = { name, price, qty: 0 };
            }
            currentContainer.items[id].qty++;
            countSpan.textContent = currentContainer.items[id].qty;
            updateActiveContainerUI();
            showToast(name);
          } else {
            if (!window.dineInCart) window.dineInCart = {};
            if (!window.dineInCart[id]) window.dineInCart[id] = { name, price, qty: 0 };
            window.dineInCart[id].qty++;
            countSpan.textContent = window.dineInCart[id].qty;
            updateGlobalCartState();
            showToast(name);
          }
        });
        
        newDec.addEventListener('click', () => {
          const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
          if (needsContainers) {
            if (currentContainer.items[id] && currentContainer.items[id].qty > 0) {
              currentContainer.items[id].qty--;
              if (currentContainer.items[id].qty === 0) {
                delete currentContainer.items[id];
                countSpan.textContent = '0';
              } else {
                countSpan.textContent = currentContainer.items[id].qty;
              }
              updateActiveContainerUI();
            }
          } else {
            if (window.dineInCart && window.dineInCart[id] && window.dineInCart[id].qty > 0) {
              window.dineInCart[id].qty--;
              if (window.dineInCart[id].qty === 0) {
                delete window.dineInCart[id];
                countSpan.textContent = '0';
              } else {
                countSpan.textContent = window.dineInCart[id].qty;
              }
              updateGlobalCartState();
            }
          }
        });
      });
    }
    
    function updateGlobalCartState() {
      const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
      let count = 0;
      if (needsContainers) {
        count = submittedContainers.length + (Object.keys(currentContainer.items).length > 0 ? 1 : 0);
      } else {
        if (window.dineInCart) {
          Object.values(window.dineInCart).forEach(i => count += i.qty);
        }
      }
      const badge = document.getElementById('header-cart-count');
      if (badge) badge.textContent = count;
    }
    
    function calculateTotalSum() {
      let subtotal = 0;
      const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
      if (needsContainers) {
        let allContainersToCheck = [...submittedContainers];
        if (Object.keys(currentContainer.items).length > 0) {
          allContainersToCheck.push(currentContainer);
        }
        allContainersToCheck.forEach(c => {
          const itemsSum = Object.values(c.items).reduce((sum, i) => sum + (i.price * i.qty), 0);
          subtotal += itemsSum + c.packagingPrice;
        });
      } else {
        if (window.dineInCart) {
          Object.values(window.dineInCart).forEach(item => {
            subtotal += item.price * item.qty;
          });
        }
      }
      return subtotal;
    }
    
    function updateGrandTotal() {
      let subtotal = calculateTotalSum();
      const subtotalEl = document.getElementById('modal-subtotal');
      const grandTotalEl = document.getElementById('modal-grand-total');
      if (subtotalEl) subtotalEl.textContent = '₦' + subtotal.toLocaleString();
      if (grandTotalEl) grandTotalEl.textContent = '₦' + subtotal.toLocaleString();
    }
    
    function renderCartModal() {
      const listContainer = document.getElementById('cart-items-list');
      const emptyMsg = document.getElementById('cart-empty-msg');
      const activeContent = document.getElementById('cart-active-content');
      const modalHeaderTitle = document.getElementById('modal-header-title');
      if (!listContainer || !emptyMsg || !activeContent) return;
      
      if (editingOrderId) {
        if (modalHeaderTitle) modalHeaderTitle.textContent = `Edit Order #${editingOrderId} & Add Items`;
      }
      
      listContainer.innerHTML = '';
      
      const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
      let allContainersToCheck = [...submittedContainers];
      if (needsContainers && Object.keys(currentContainer.items).length > 0) {
        allContainersToCheck.push(currentContainer);
      }
      
      let hasItems = false;
      if (needsContainers) {
        hasItems = allContainersToCheck.length > 0;
        if (hasItems) {
          allContainersToCheck.forEach((c, index) => {
            const itemStrs = Object.values(c.items).map(i => `${i.name} (x${i.qty})`).join(', ');
            const containerTotal = Object.values(c.items).reduce((sum, i) => sum + (i.price * i.qty), 0) + c.packagingPrice;
            
            const row = document.createElement('div');
            row.className = 'cart-container-row';
            row.innerHTML = `
              <div style="font-weight: bold; color: var(--brand-bottom);">Container #${index + 1} (${c.packaging})</div>
              <div style="font-size: 0.75rem; color: var(--text-muted);">${itemStrs}</div>
              <div style="display: flex; justify-content: space-between; margin-top: 4px; font-weight: 600;">
                <span>Container Subtotal + Pack</span>
                <span>₦${containerTotal.toLocaleString()}</span>
              </div>
            `;
            listContainer.appendChild(row);
          });
        }
      } else {
        hasItems = window.dineInCart && Object.keys(window.dineInCart).length > 0;
        if (hasItems) {
          Object.values(window.dineInCart).forEach(item => {
            const row = document.createElement('div');
            row.className = 'cart-container-row';
            row.innerHTML = `
              <div style="display: flex; justify-content: space-between;">
                <span>${item.name} (x${item.qty})</span>
                <span style="font-weight: bold; color: var(--brand-bottom);">₦${(item.price * item.qty).toLocaleString()}</span>
              </div>
            `;
            listContainer.appendChild(row);
          });
        }
      }
      if (!hasItems) {
        emptyMsg.style.display = 'block';
        activeContent.style.display = 'none';
        return;
      }
      emptyMsg.style.display = 'none';
      activeContent.style.display = 'flex';
      
      updateGrandTotal();
    }
    
    function submitOrder() {
      const needsContainers = (currentServiceMode === 'Online Takeaway' || currentServiceMode === 'Physical Takeaway' || currentServiceMode === 'Home Delivery');
      if (needsContainers && Object.keys(currentContainer.items).length > 0) {
        submittedContainers.push(JSON.parse(JSON.stringify(currentContainer)));
        currentContainer = { packaging: 'Standard Container', packagingPrice: 500, items: {} };
      }
      
      const subtotalEl = document.getElementById('modal-subtotal');
      const grandTotalEl = document.getElementById('modal-grand-total');
      const grandTotal = grandTotalEl ? grandTotalEl.textContent : '₦0';
      const subtotalVal = subtotalEl ? subtotalEl.textContent : '₦0';
      const orderId = editingOrderId ? editingOrderId : ('NSC-' + Math.floor(100000 + Math.random() * 900000));
      
      pendingOrderData = {
        order: {
          order_id: orderId,
          customer_name: 'Existing Customer (Order #' + orderId + ')',
          phone: '00000000000',
          service_mode: currentServiceMode,
          fulfillment_type: currentServiceMode,
          payment_method: 'Existing Order Append',
          subtotal: subtotalVal,
          grand_total: grandTotal,
          containers: submittedContainers,
          dine_in_items: window.dineInCart || {}
        }
      };
      
      submittedContainers = [];
      window.dineInCart = {};
      currentContainer = { packaging: 'Standard Container', packagingPrice: 500, items: {} };
      
      document.querySelectorAll('.step-count').forEach(span => { span.textContent = '0'; });
      if (needsContainers) updateActiveContainerUI();
      updateGlobalCartState();
      closeCheckoutModal();
      
      const receiptBody = document.getElementById('receipt-body');
      if (receiptBody) {
        receiptBody.innerHTML = generateReceiptHTML(pendingOrderData.order);
      }
      
      const receiptModal = document.getElementById('receipt-modal');
      if (receiptModal) receiptModal.style.display = 'flex';
      
      sendOrderToBackend(pendingOrderData);
    }
    
    function generateReceiptHTML(order) {
      let itemsHTML = '';
      if (order.service_mode === 'Online Takeaway' || order.service_mode === 'Physical Takeaway' || order.service_mode === 'Home Delivery') {
        order.containers.forEach((c, idx) => {
          const itemsList = Object.values(c.items).map(i => `${i.name} (x${i.qty}) - ₦${(i.price * i.qty).toLocaleString()}`).join('<br>');
          const cTotal = Object.values(c.items).reduce((sum, i) => sum + (i.price * i.qty), 0) + c.packagingPrice;
          itemsHTML += `<div style="margin-bottom: 8px; border-bottom: 1px dashed var(--border-color); padding-bottom: 6px;">
            <strong>Container #${idx + 1} (${c.packaging})</strong><br>
            ${itemsList}<br>
            <span style="color: var(--brand-bottom);">Container Total: ₦${cTotal.toLocaleString()}</span>
          </div>`;
        });
      } else {
        Object.values(order.dine_in_items).forEach(item => {
          itemsHTML += `<div>${item.name} x${item.qty} - ₦${(item.price * item.qty).toLocaleString()}</div>`;
        });
      }
      
      return `
        <div style="text-align: center; border-bottom: 2px dashed var(--border-color); padding-bottom: 12px; margin-bottom: 12px;">
          <h2 style="margin: 0; color: var(--brand-bottom); font-size: 1.1rem;">Newsong Cookitz House</h2>
          <p style="margin: 2px 0; font-size: 0.75rem; color: var(--text-muted);">Additional Items Receipt (Order #${order.order_id})</p>
          <p style="margin: 2px 0; font-size: 0.75rem;">Date: ${new Date().toLocaleString()}</p>
        </div>
        <div style="border-top: 1px dashed var(--border-color); border-bottom: 1px dashed var(--border-color); padding: 8px 0; margin-bottom: 10px;">
          <div style="font-weight: bold; margin-bottom: 4px; font-size: 0.75rem; text-transform: uppercase;">Added Items Breakdown</div>
          ${itemsHTML}
        </div>
        <div style="font-size: 0.8rem;">
          <div style="display: flex; justify-content: space-between; font-weight: 800; font-size: 0.9rem; color: var(--brand-bottom); border-top: 1px solid var(--border-color); padding-top: 6px; margin-top: 4px;">
            <span>Additional Grand Total:</span> <span>${order.grand_total}</span>
          </div>
        </div>
      `;
    }
    
    function printReceipt() {
      const receiptBody = document.getElementById('receipt-body');
      if (!receiptBody) return;
      const receiptContent = receiptBody.innerHTML;
      const printWindow = window.open('', '_blank', 'width=600,height=600');
      if (printWindow) {
        printWindow.document.write(`
          <html>
            <head><title>Print E-Receipt - Newsong Cookitz House</title></head>
            <body style="font-family: monospace; padding: 20px; color: #000; background: #fff;">
              ${receiptContent}
              <script>window.print(); window.close();<\/script>
            </body>
          </html>
        `);
        printWindow.document.close();
      }
    }
    
    function sendOrderToBackend(orderData) {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
      const endpoint = editingOrderId ? `/cashier/orders/${editingOrderId}/append_item` : '/orders';
      const method = 'POST';
      
      fetch(endpoint, {
        method: method,
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {})
        },
        body: JSON.stringify(orderData)
      })
      .then(res => res.json())
      .then(data => {
        console.log('Order successfully updated in database:', data);
      })
      .catch(err => {
        console.error('Error syncing order update:', err);
      });
    }
    
    function closeReceiptModal() {
      const receiptModal = document.getElementById('receipt-modal');
      if (receiptModal) receiptModal.style.display = 'none';
      if (editingOrderId) {
        window.location.href = `/cashier/orders/${editingOrderId}/edit`;
      } else {
        window.location.href = '/cashier';
      }
    }
    
    window.onload = () => {
      renderMenu();
      updateThemeButtons(document.body.classList.contains('light-mode'));
      
      if (EXTERNAL_FORM_LINK && EXTERNAL_FORM_LINK.trim() !== "") {
        const formLinkBtn = document.getElementById('external-form-link-btn');
        if (formLinkBtn) {
          formLinkBtn.href = EXTERNAL_FORM_LINK;
          formLinkBtn.style.display = 'inline-flex';
        }
      }
      
      const pathSegments = window.location.pathname.split('/');
      const ordersIndex = pathSegments.indexOf('orders');
      if (ordersIndex !== -1 && pathSegments[ordersIndex + 1]) {
        editingOrderId = pathSegments[ordersIndex + 1];
      } else {
        const urlParams = new URLSearchParams(window.location.search);
        const orderIdParam = urlParams.get('order_id');
        if (orderIdParam) {
          editingOrderId = orderIdParam;
        }
      }
      
      const fulfillmentParam = new URLSearchParams(window.location.search).get('fulfillment');
      if (fulfillmentParam) {
        initializeServiceMode(fulfillmentParam);
      } else {
        initializeServiceMode('Dine-In');
      }
    };
  </script>
</body>
</html>
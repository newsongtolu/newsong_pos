<div class="min-h-screen bg-[#090e1a] text-slate-100 p-6">
  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Header & Search Bar Section -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-slate-900 border border-slate-800 p-6 rounded-2xl shadow-xl">
      <div>
        <span class="text-xs uppercase tracking-widest text-amber-400 font-semibold bg-amber-500/10 px-3 py-1 rounded-full">
          Cashier Display Terminal
        </span>
        <h1 class="text-2xl font-black text-white mt-2">Incoming Order Queue</h1>
        <p class="text-xs text-slate-400">Review, search, verify payments, or securely edit active orders.</p>
      </div>

      <!-- Search Bar Form -->
      <%= form_with url: cashier_orders_path, method: :get, local: true, class: "flex items-center gap-2" do %>
        <div class="relative">
          <%= text_field_tag :search, params[:search], placeholder: "Search by customer name or phone...", class: "bg-slate-800 border border-slate-700 text-white text-xs rounded-xl px-4 py-2.5 pl-9 focus:outline-none focus:border-amber-500 w-64" %>
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <%= submit_tag "Search", class: "bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2.5 rounded-xl text-xs transition-colors cursor-pointer" %>
        <% if params[:search].present? %>
          <%= link_to "Clear", cashier_orders_path, class: "bg-slate-800 hover:bg-slate-700 text-slate-300 px-3 py-2.5 rounded-xl text-xs font-semibold" %>
        <% end %>
      <% end %>
    </div>

    <!-- Orders Grid / List -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% if @orders.any? %>
        <% @orders.each do |order| %>
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg flex flex-col justify-between space-y-4">
            
            <!-- Customer Identity & Mode -->
            <div class="flex items-start justify-between border-b border-slate-800 pb-3">
              <div>
                <span class="text-[10px] font-bold text-slate-500 uppercase">Customer Name</span>
                <h3 class="text-base font-bold text-white"><%= order.customer_name.presence || "Walk-in Customer" %></h3>
                <span class="text-xs text-slate-400 font-mono"><%= order.phone.presence || "No Phone Provided" %></span>
              </div>
              <div class="text-right">
                <span class="text-[10px] font-bold text-amber-400 bg-amber-500/10 px-2 py-1 rounded">
                  <%= order.fulfillment_type.presence || "Standard" %> &bull; <%= order.service_mode.presence || "Counter" %>
                </span>
                <span class="block text-[10px] text-slate-500 mt-1">Order #<%= order.id %></span>
              </div>
            </div>

            <!-- Detailed Item Breakdown -->
            <div class="bg-slate-800/40 p-3 rounded-xl border border-slate-800/80 space-y-1.5">
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">Order Items Breakdown</span>
              <% if order.order_items.any? %>
                <% order.order_items.each do |item| %>
                  <div class="flex justify-between text-xs text-slate-300">
                    <span><%= item.quantity %>x <%= item.name %></span>
                    <span class="font-mono text-emerald-400">₦<%= number_with_precision(item.price.to_f * item.quantity.to_f, precision: 2) %></span>
                  </div>
                <% end %>
              <% else %>
                <p class="text-xs text-amber-400/80 italic">⚠️ No item rows attached to this order record yet. Click 'Edit / Adjust' to add items.</p>
              <% end %>
            </div>

            <!-- Payment Info & Grand Total -->
            <div class="flex items-center justify-between pt-2 border-t border-slate-800/60">
              <div>
                <span class="text-[10px] font-bold text-slate-500 uppercase block">Payment Method</span>
                <span class="text-xs font-semibold text-slate-200"><%= order.payment_method.presence || "Pending Selection" %></span>
              </div>
              <div class="text-right">
                <span class="text-[10px] font-bold text-slate-500 uppercase block">Grand Total</span>
                <span class="text-sm font-black text-emerald-400">₦<%= number_with_precision(order.grand_total.to_f, precision: 2) %></span>
              </div>
            </div>

            <!-- Actions: Polished Side-by-Side Buttons -->
            <div class="grid grid-cols-2 gap-3 pt-2">
             <%= link_to "Edit Order", edit_cashier_order_path(order), data: { turbo_prefetch: "false" }, class: "inline-flex items-center px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-amber-400 font-medium text-sm hover:bg-slate-700 transition" %>
              
              <%= button_to "Verify & Route", verify_payment_cashier_order_path(order), method: :patch, class: "w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-xl text-xs transition-colors cursor-pointer shadow-md text-center" %>
            </div>

          </div>
        <% end %>
      <% else %>
        <div class="col-span-2 text-center py-16 bg-slate-900 border border-slate-800 rounded-2xl">
          <p class="text-sm text-slate-400">No active incoming orders in the queue. Screen is clean!</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
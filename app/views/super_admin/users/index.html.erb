<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage All System Users - Super Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root { --bg-main: #0b0f19; --bg-card: #151c2c; --border-color: #26334d; --text-main: #f1f5f9; --text-muted: #94a3b8; --accent: #f59e0b; }
    body { background-color: var(--bg-main); color: var(--text-main); font-family: system-ui, sans-serif; margin: 0; padding: 20px; }
    .container { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
    .card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; }
    .btn { background: var(--accent); color: white; border: none; padding: 8px 14px; border-radius: 6px; font-weight: bold; cursor: pointer; text-decoration: none; display: inline-block; font-size: 0.9rem; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; text-align: left; }
    th, td { padding: 12px; border-bottom: 1px solid var(--border-color); font-size: 0.9rem; vertical-align: middle; }
    th { color: var(--text-muted); font-weight: 600; }
  </style>
</head>
<body>
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h1 style="margin: 0; font-size: 1.4rem; color: #f59e0b;">⚡ Global System Users Management</h1>
        <p style="margin: 4px 0 0 0; color: var(--text-muted); font-size: 0.85rem;">Manage all accounts, administrative roles, and station assignments across the network.</p>
      </div>
      <div style="display: flex; gap: 10px;">
        <%= link_to "+ Add System User", new_super_admin_user_path, class: "btn", style: "background: #f59e0b;" %>
        <%= link_to "← Super Admin Dashboard", super_admin_dashboards_path, class: "btn", style: "background: #374151;" %>
      </div>
    </div>

    <div class="card">
      <h3 style="margin-top: 0; font-size: 1rem;">All Registered Users</h3>
      <div style="overflow-x: auto;">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Station Assignment</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if @users.any? %>
              <% @users.each do |user| %>
                <tr>
                  <td style="font-weight: 500;"><%= user.respond_to?(:name) && user.name.presence ? user.name : "System User" %></td>
                  <td style="color: var(--text-muted);"><%= user.email %></td>
                  <td>
                    <span style="padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; background: #1e293b; color: #f59e0b;">
                      <%= user.role.titleize rescue 'Standard' %>
                    </span>
                  </td>
                  <td style="color: var(--text-muted);">
                    <%= user.respond_to?(:station) && user.station.presence ? user.station.titleize : "Not Assigned" %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: flex; gap: 8px; justify-content: flex-end; align-items: center;">
                      <%= link_to "Edit", edit_super_admin_user_path(user), class: "btn", style: "background: #2563eb; padding: 6px 10px; font-size: 0.75rem;" %>
                      <%= button_to "Delete", super_admin_user_path(user), method: :delete, form: { data: { turbo_confirm: "Are you sure you want to delete this user?" } }, class: "btn", style: "background: #dc2626; padding: 6px 10px; font-size: 0.75rem;" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 30px;">No users found in the system.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
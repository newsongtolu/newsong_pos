<div class="min-h-screen bg-[#0f172a] text-white p-8">
  <div class="max-w-xl mx-auto bg-[#1e293b] p-8 rounded-2xl border border-slate-700/80 shadow-2xl space-y-6">
    <div class="flex justify-between items-center border-b border-slate-700 pb-4">
      <h2 class="text-xl font-bold tracking-tight">Add New Staff Member</h2>
      <%= link_to "Back to Users", super_admin_users_path, class: "text-xs bg-slate-700 hover:bg-slate-600 px-3 py-1.5 rounded-lg text-slate-300 transition" %>
    </div>

    <%= form_with model: [:super_admin, @user], local: true, class: "space-y-4" do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-red-500/10 border border-red-500 text-red-400 px-4 py-3 rounded-xl text-sm">
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-1">
        <label class="text-xs font-bold text-slate-300 uppercase">Email Address</label>
        <%= f.email_field :email, required: true, class: "w-full bg-[#0f172a] border border-slate-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-emerald-500" %>
      </div>

      <div class="space-y-1">
        <label class="text-xs font-bold text-slate-300 uppercase">Staff Role</label>
        <%= f.select :role, [["Super Admin", "super_admin"], ["Admin", "admin"], ["Cashier", "cashier"], ["Kitchen", "kitchen"], ["Floor", "floor"], ["Dispatch", "dispatch"]], {}, class: "w-full bg-[#0f172a] border border-slate-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-emerald-500" %>
      </div>

      <div class="space-y-1">
        <label class="text-xs font-bold text-slate-300 uppercase">Password</label>
        <%= f.password_field :password, required: true, class: "w-full bg-[#0f172a] border border-slate-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-emerald-500" %>
      </div>

      <div class="space-y-1">
        <label class="text-xs font-bold text-slate-300 uppercase">Confirm Password</label>
        <%= f.password_field :password_confirmation, required: true, class: "w-full bg-[#0f172a] border border-slate-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-emerald-500" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Create Staff Account", class: "w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 px-4 rounded-xl transition text-center shadow-lg cursor-pointer text-sm" %>
      </div>
    <% end %>
  </div>
</div>
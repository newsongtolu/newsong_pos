<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-6">
  <!-- KITCHEN TERMINAL HEADER -->
  <div class="flex flex-col sm:flex-row justify-between items-center bg-[#1e293b] p-6 rounded-2xl border border-slate-700/80 shadow-xl gap-4">
    <div class="space-y-1 text-center sm:text-left">
      <span class="inline-block text-[10px] font-extrabold text-amber-400 uppercase tracking-widest bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20">
        Live Kitchen Display System (KDS)
      </span>
      <h2 class="text-2xl font-black text-white tracking-tight">Active Kitchen Tickets</h2>
    </div>
    <div class="flex items-center gap-3">
      <span class="bg-slate-800 text-slate-300 text-xs font-bold px-4 py-2 rounded-xl border border-slate-700">
        Active Orders: <strong class="text-emerald-400"><%= @orders.count %></strong>
      </span>
    </div>
  </div>

  <!-- ORDERS GRID -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @orders.each do |order| %>
      <div class="bg-[#1e293b] rounded-2xl border border-slate-700/80 shadow-xl flex flex-col overflow-hidden">
        
        <!-- TICKET HEADER -->
        <div class="bg-slate-800/80 p-4 border-b border-slate-700/60 flex justify-between items-center">
          <div>
            <span class="text-xs font-bold text-slate-400 uppercase">Order ID</span>
            <h3 class="text-lg font-black text-white">#<%= order.id %></h3>
          </div>
          <div class="text-right">
            <span class="text-[10px] uppercase font-bold px-2.5 py-1 rounded-md 
              <%= order.kitchen_status == 'preparing' ? 'bg-amber-900/50 text-amber-400 border border-amber-800' : 'bg-blue-900/50 text-blue-400 border border-blue-800' %>">
              <%= order.kitchen_status.present? ? order.kitchen_status.titleize : 'Pending' %>
            </span>
            <span class="block text-[10px] text-slate-400 mt-1"><%= time_ago_in_words(order.created_at) %> ago</span>
          </div>
        </div>

        <!-- CUSTOMER & SERVICE INFO -->
        <div class="px-4 py-3 bg-[#0f172a]/50 border-b border-slate-700/40 text-xs flex justify-between items-center text-slate-300">
          <span>Customer: <strong class="text-white"><%= order.customer_name.presence || 'Walk-in' %></strong></span>
          <span class="text-amber-400 font-semibold"><%= order.payment_method&.titleize || 'Cash' %></span>
        </div>

        <!-- ITEMS LIST -->
        <div class="p-4 flex-1 space-y-3">
          <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Items to Prepare:</span>
          
          <% 
            original_items = order.order_items.reject(&:is_appended)
            appended_items = order.order_items.select(&:is_appended)
          %>

          <!-- Original Order Items -->
          <div class="space-y-2">
            <% original_items.each do |item| %>
              <div class="flex justify-between items-center bg-[#0f172a] p-3 rounded-xl border border-slate-700/60">
                <span class="text-sm font-bold text-white"><%= item.name || item.menu_item&.name %></span>
                <span class="bg-slate-800 text-amber-400 text-xs font-black px-2.5 py-1 rounded-lg border border-slate-700">
                  x<%= item.quantity %>
                </span>
              </div>
            <% end %>
          </div>

          <!-- Newly Appended / Added Items (Distinct Section) -->
          <% if appended_items.any? %>
            <div class="mt-4 pt-3 border-t border-amber-500/30">
              <div class="flex items-center gap-1.5 mb-2.5 text-amber-400 font-bold text-[11px] uppercase tracking-wider">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                <span>New Additions / Appended Items</span>
              </div>

              <div class="space-y-2">
                <% appended_items.each do |item| %>
                  <div class="flex justify-between items-center bg-amber-500/10 p-3 rounded-xl border border-amber-500/30">
                    <span class="text-sm font-bold text-amber-200"><%= item.name || item.menu_item&.name %></span>
                    <span class="bg-amber-500 text-slate-950 text-xs font-black px-2.5 py-1 rounded-lg">
                      x<%= item.quantity %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- KITCHEN ACTION FOOTER -->
        <div class="p-4 bg-slate-900/60 border-t border-slate-700/60 flex gap-2">
          <% if order.kitchen_status != 'preparing' %>
            <%= button_to "Start Cooking", kitchen_order_path(order, kitchen_status: 'preparing'), method: :patch, class: "flex-1 bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold py-3 px-3 rounded-xl transition text-center shadow-lg cursor-pointer" %>
          <% else %>
            <%= button_to "Mark Ready", kitchen_order_path(order, kitchen_status: 'ready'), method: :patch, class: "flex-1 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold py-3 px-3 rounded-xl transition text-center shadow-lg cursor-pointer" %>
          <% end %>
        </div>

      </div>
    <% end %>

    <% if @orders.empty? %>
      <div class="col-span-full py-16 bg-[#1e293b] rounded-2xl border border-slate-700/80 text-center space-y-2">
        <p class="text-sm font-bold text-slate-400">No active kitchen orders right now.</p>
        <p class="text-xs text-slate-500">New orders placed from the cashier terminal will appear here instantly.</p>
      </div>
    <% end %>
  </div>
</div>
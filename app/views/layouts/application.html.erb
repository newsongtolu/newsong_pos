<!DOCTYPE html>
<html>
  <head>
    <title>NewsongPos</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Add Tailwind Play CDN for instant styling -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <% if AppSetting.first&.paystack_link.present? %>
      <script>
        window.APP_PAYSTACK_LINK = "<%= j AppSetting.first.paystack_link %>";
      </script>
    <% end %>
  </head>

  <body data-controller="checkout">
    <%= yield %>
  </body>
</html>